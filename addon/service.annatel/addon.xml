<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.annatel"
       name="Annatel IPTV"
       version="1.0.0"
       provider-name="annatel-kodi">

  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="pvr.iptvsimple"/>
  </requires>

  <extension point="xbmc.service" library="addon.py" start="login"/>

  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Annatel IPTV</summary>
    <description lang="en_GB">Automatically fetches your Annatel IPTV channel list and configures IPTV Simple Client. Only username and password are required — everything else is handled automatically. Channels refresh every 4 hours.</description>
    <disclaimer lang="en_GB">Requires a valid Annatel subscription.</disclaimer>
    <platform>all</platform>
    <license>GPL-2.0-only</license>
  </extension>

</addon>
